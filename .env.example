# Documentation only: export these variables in your shell; .env is not auto-loaded.
SENTINEL_MODEL_DIR=models
SENTINEL_LLAMA_DIR=models/llama
# Optional separate runtime environment (absolute path, same operating system)
# SENTINEL_LLAMA_PYTHON=/absolute/path/.venv-llama/bin/python
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
